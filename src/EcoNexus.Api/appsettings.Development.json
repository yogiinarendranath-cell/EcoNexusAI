    "SecretKey": "DEV-ONLY-EcoNexus-JWT-Secret-Key-Do-Not-Use-In-Production-0123456789",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "AI": {
    "Provider": "Mock",
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "llava",
      "TimeoutSeconds": 120
    }
  }
}

