{
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ],
    "AllowAnyOrigin": false,
    "AllowCredentials": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=EcoNexusAIDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "EcoNexus.Api",
    "Audience": "EcoNexus.Client",
    "SecretKey": "DEV-ONLY-EcoNexus-JWT-Secret-Key-Do-Not-Use-In-Production-0123456789",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "AI": {
    "Provider": "Mock",
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "llava",
      "TimeoutSeconds": 120
    }
  }
}